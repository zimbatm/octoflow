# GitHub webhook configuration (optional but recommended for production)
# If not set, webhook signature validation will be skipped
# WEBHOOK_SECRET=your-github-webhook-secret-here

# S3 configuration
S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Optional: Override default ports
# WEBHOOK_LISTEN_ADDR=:8080
# SSE_LISTEN_ADDR=:8081
# NATS_URL=nats://localhost:4222

# Optional: NATS authentication
# NATS_USERNAME=nats-user
# NATS_PASSWORD=nats-password

# Optional: MinIO configuration (for local development)
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# S3_ENDPOINT=http://localhost:9000