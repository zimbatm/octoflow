# GitHub webhook secret. Without it the receiver accepts unsigned deliveries.
# WEBHOOK_SECRET=your-github-webhook-secret-here
# Comma-separated GitHub organizations to accept; empty accepts all.
# WEBHOOK_ALLOWED_ORGS=numtide

# S3 configuration (only the s3-worker needs it)
S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# Local rustfs from the Procfile; leave unset for AWS
# S3_ENDPOINT=http://127.0.0.1:9000

# Optional: override default ports
# WEBHOOK_LISTEN_ADDR=:8080
# SSE_LISTEN_ADDR=:8081
# NATS_URL=nats://localhost:4222

# Optional: NATS authentication (user/password, token or nkey seed)
# NATS_USERNAME=nats-user
# NATS_PASSWORD=nats-password
# NATS_TOKEN=
# NATS_NKEY_SEED=

# Optional: public-ingest, see the README
# PUBLIC_REPOS=NixOS/nixpkgs
# GITHUB_TOKEN=
