# Copy to .env; `nix develop` loads it.

# GitHub webhook secret. The receiver refuses to start without one.
WEBHOOK_SECRET=change-me
# Accept unsigned deliveries instead (development only):
# WEBHOOK_ALLOW_UNSIGNED=true
# Comma-separated GitHub organizations to accept; empty accepts all.
# WEBHOOK_ALLOWED_ORGS=numtide

# S3 configuration (only the s3 service needs it)
S3_BUCKET=octoflow
# S3_BATCH_TIMEOUT=1h   # one file per hour at most for a quiet repository; S3_BATCH_SIZE=1000, S3_BATCH_MAX_BYTES=100MiB
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=octoflow
AWS_SECRET_ACCESS_KEY=octoflow-dev-secret
# Local rustfs from the Procfile; leave unset for AWS
S3_ENDPOINT=http://127.0.0.1:9000

# Optional: override default addresses
# HTTP_LISTEN_ADDR=:8080   # webhook, SSE and dashboard; WEBHOOK_/SSE_/DASHBOARD_LISTEN_ADDR give one its own server
# NATS_URL=nats://localhost:4222
# NATS_STREAM_MAX_BYTES=10GiB   # size cap of the stream, oldest messages dropped first; default none

# Optional: NATS authentication (user/password, token or nkey seed)
# NATS_USERNAME=nats-user
# NATS_PASSWORD=nats-password
# NATS_TOKEN=
# NATS_NKEY_SEED=

# Optional: public-ingest, see the README
# PUBLIC_REPOS=NixOS/nixpkgs
# GITHUB_TOKEN=

# Optional: observability
# METRICS_LISTEN_ADDR=:9180     # Prometheus /metrics and /healthz; unset disables
# LOG_FORMAT=json               # text (default) or json
# LOG_LEVEL=info                # debug, info, warn, error
