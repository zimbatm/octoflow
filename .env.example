# GitHub webhook configuration (optional but recommended for production)
# If not set, webhook signature validation will be skipped
# WEBHOOK_SECRET=your-github-webhook-secret-here

# S3 configuration
S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Optional: Override default ports
# WEBHOOK_LISTEN_ADDR=:8080
# SSE_LISTEN_ADDR=:8081
# NATS_URL=nats://localhost:4222

# Optional: NATS authentication
# NATS_USERNAME=nats-user
# NATS_PASSWORD=nats-password

# Local development with rustfs (started by the Procfile).
# Comment out the S3 block above and use these instead.
# rustfs takes its root credential from the AWS_* variables.
# S3_BUCKET=octoflow
# S3_ENDPOINT=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=octoflow-dev
# AWS_SECRET_ACCESS_KEY=octoflow-dev-secret
